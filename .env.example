# Required: Your Google Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_api_key_here

# Optional: Model configuration
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.7
GEMINI_SYSTEM_INSTRUCTION=You are Ms. Minute, a sharp, helpful, and friendly AI assistant. Keep responses clear, concise, and practical.

# Optional: Memory and network settings
MAX_HISTORY_MESSAGES=10
REQUEST_TIMEOUT_SECONDS=60
